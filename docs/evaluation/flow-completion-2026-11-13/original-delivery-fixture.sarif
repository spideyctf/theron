              "id": "PY-SAST-PATH-001",
              "name": "sast",
              "shortDescription": {
                "text": "External input controls a filesystem path"
              },
              "fullDescription": {
                "text": "External input from line 11 reaches a file operation without an observed path boundary."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PY-SAST-ARCHIVE-001",
              "name": "sast",
              "shortDescription": {
                "text": "Untrusted archive reaches fully-trusted extraction"
              },
              "fullDescription": {
                "text": "The resolved extractor explicitly uses fully_trusted filtering. An observed external file object reaches the archive reader."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PY-SAST-ARCHIVE-REVIEW-001",
              "name": "sast",
              "shortDescription": {
                "text": "Archive extraction filter needs runtime/context review"
              },
              "fullDescription": {
                "text": "No unambiguous data filter is observed. Python 3.14+ changed the default to data; older runtimes, custom filters, member guards and archive trust need review. This is not a confirmed path-traversal finding."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
