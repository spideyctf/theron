{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Theron",
          "version": "1.0.0",
          "informationUri": "https://github.com/spideyctf/theron",
          "rules": [
            {
              "id": "PY-SHELL-PEER-001",
              "name": "sast",
              "shortDescription": {
                "text": "Peer address used as a shell command; injection control unverified"
              },
              "fullDescription": {
                "text": "A peer address reaches a shell command. Normal IP address syntax does not establish attacker-controlled shell syntax; proxy and deployment semantics need review."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "PY-SAST-SESSION-001",
              "name": "sast",
              "shortDescription": {
                "text": "External input crosses a session storage boundary"
              },
              "fullDescription": {
                "text": "A request-controlled value is stored under a fixed session key. This alone does not establish a privilege or authorization violation."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/501.html",
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "PY-SAST-PATH-001",
              "name": "sast",
              "shortDescription": {
                "text": "External input controls a filesystem path"
              },
              "fullDescription": {
                "text": "External input from line 70 reaches a file operation without an observed path boundary."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PY-PARSE-001",
              "name": "sast",
              "shortDescription": {
                "text": "Python analysis skipped: syntax could not be parsed"
              },
              "fullDescription": {
                "text": "Syntax-aware checks could not analyse this file."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "PY-SAST-SSTI-001",
              "name": "sast",
              "shortDescription": {
                "text": "Untrusted text controls server-side template source"
              },
              "fullDescription": {
                "text": "Untrusted text from line 11 reaches the source argument of a resolved template-string renderer. Context-variable values are not treated as template source."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1336.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AI-ID-003",
              "name": "insecure_model_deployment",
              "shortDescription": {
                "text": "Debug Mode Enabled"
              },
              "fullDescription": {
                "text": "Debug mode enabled \u00e2\u20ac\u201d exposes stack traces and sensitive information."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/489.html",
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "AI-ID-001",
              "name": "insecure_model_deployment",
              "shortDescription": {
                "text": "Flask App Bound to All Interfaces"
              },
              "fullDescription": {
                "text": "Flask app bound to 0.0.0.0 \u00e2\u20ac\u201d model endpoint exposed to the entire network."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "AI-SE-018",
              "name": "secret_exposure",
              "shortDescription": {
                "text": "Hardcoded Secret/Password (unverified)"
              },
              "fullDescription": {
                "text": "A provider-shaped credential pattern was found at this location. Validity and actual use have not been verified."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "JS-SAST-CMD-001",
              "name": "sast",
              "shortDescription": {
                "text": "External input controls process execution"
              },
              "fullDescription": {
                "text": "A supported syntax-level source reaches the statement/command/HTML argument. Callback arguments are not treated as model output. Startup, branch feasibility and exploitability are unverified."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "JS-SAST-SQL-001",
              "name": "sast",
              "shortDescription": {
                "text": "External input is interpolated into a SQL statement"
              },
              "fullDescription": {
                "text": "A supported syntax-level source reaches the statement/command/HTML argument. Callback arguments are not treated as model output. Startup, branch feasibility and exploitability are unverified."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "JS-PARSE-001",
              "name": "sast",
              "shortDescription": {
                "text": "JavaScript/TypeScript syntax analysis incomplete"
              },
              "fullDescription": {
                "text": "The selected grammar could not parse this file completely. Source/sink checks were skipped; regex fallbacks do not establish semantic coverage."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "sca",
              "name": "sca",
              "shortDescription": {
                "text": "No Dependency Declarations Parsed"
              },
              "fullDescription": {
                "text": "No dependency declarations could be parsed from supported manifests. SCA coverage is incomplete, not a clean bill of health."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
      },
